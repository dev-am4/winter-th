{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "winter-th",
	"workers_dev": true,
	"compatibility_date": "2026-09-29",
	"main": "./worker/index.ts",
	"assets": {
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		"run_worker_first": [
			"/api/*"
		]
	},
	"routes": [
		{
			"pattern": "www.dev2u.online",
			"custom_domain": true
		}
	],
	"observability": {
		"enabled": true,
		"head_sampling_rate": 0.05
	},
	"d1_databases": [
		{
			"binding": "POSTS_DB",
			"database_name": "winter-posts",
			"database_id": "ebfeb908-d062-41ab-aba1-637d1bdb95d7"
		}
	]
}