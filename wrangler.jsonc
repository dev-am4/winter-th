{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "winter-th",
	"workers_dev": true,
	"compatibility_date": "2026-09-29",
	"main": "./worker/index.ts",
	"assets": {
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		"run_worker_first": [
			"/api/*"
		]
	},
	"routes": [
		{
			"pattern": "www.dev2u.online",
			"custom_domain": true
		}
	],
	"observability": {
		"enabled": true,
		"head_sampling_rate": 0.05
	},
	"d1_databases": [
		{
			"binding": "POSTS_DB",
			"database_name": "winter-posts",
			"database_id": "ebfeb908-d062-41ab-aba1-637d1bdb95d7"
		}
	],
	"queues": {
		"producers": [
			{
				"binding": "DISCOVERY_QUEUE",
				"queue": "winter-discovery"
			}
		],
		"consumers": [
			{
				"queue": "winter-discovery",
				"max_batch_size": 10,
				"max_batch_timeout": 5,
				"max_retries": 2
			}
		]
	},
	"triggers": {
		"crons": [
			"*/15 * * * *"
		]
	}
}