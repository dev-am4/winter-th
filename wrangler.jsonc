{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "winter-th",
  "compatibility_date": "2026-09-29",
  "main": "./worker/index.ts",
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.05
  }
}
